.custom-tab-bar{-webkit-backdrop-filter:blur(34rpx) saturate(170%);backdrop-filter:blur(34rpx) saturate(170%);background:linear-gradient(145deg,rgba(35,92,207,.9),rgba(16,52,145,.86));border:1rpx solid hsla(0,0%,100%,.72);border-radius:38rpx;bottom:calc(env(safe-area-inset-bottom) + 8rpx);box-shadow:0 18rpx 54rpx rgba(3,17,67,.22),inset 0 2rpx 0 hsla(0,0%,100%,.94);box-sizing:border-box;display:flex;height:88rpx;left:24rpx;overflow:hidden;padding:8rpx 28rpx;position:fixed;right:24rpx;z-index:999}.tab-item{align-items:center;color:hsla(0,0%,100%,.55);display:flex;flex:1;justify-content:center;position:relative;transition:color .22s ease,background-color .22s ease,transform .22s ease}.tab-item__label{display:block;font-size:32rpx;font-weight:700;letter-spacing:1rpx;text-align:center;transition:color .22s ease,opacity .22s ease;width:100%}.tab-item__indicator{background:transparent;border-radius:999rpx;bottom:2rpx;height:5rpx;opacity:0;position:absolute;transform:scaleX(.3);transition:background-color .22s ease,opacity .22s ease,transform .24s cubic-bezier(.22,1,.36,1);width:34rpx}.tab-item--active{background:hsla(0,0%,100%,.16);border-radius:24rpx;color:#fff;transform:translateY(-1rpx)}.tab-item--active .tab-item__indicator{background:#fff;opacity:1;transform:scaleX(1)}